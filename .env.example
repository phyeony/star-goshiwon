SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
FROM_EMAIL=noreply@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id


# KakaoTalk 알림톡 via Sendon (센드온 > 마이페이지 > API KEY). The server's IP
# must be on Sendon's IP whitelist.
SENDON_ID=
SENDON_API_KEY=
# 카카오 채널 ID registered in Sendon (발신프로필)
SENDON_PROFILE_ID=
# Template IDs Sendon shows for each approved template
SENDON_TEMPLATE_BOOKING_RECEIVED=
SENDON_TEMPLATE_BOOKING_CONFIRMED=
SENDON_TEMPLATE_MONTHLY_RENT_DUE=
# "template" = send the template's SMS fallback text if KakaoTalk delivery fails
ALIMTALK_FALLBACK=
# Local dev / staging: every 알림톡 goes to this phone instead of the guest
ALIMTALK_DEV_PHONE_OVERRIDE=
