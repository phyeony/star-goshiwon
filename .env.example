SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
FROM_EMAIL=noreply@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# WhatsApp agent (lib/whatsapp/runtime.ts). Staging uses Meta's test number.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# openssl rand -hex 32 (32+ characters, or the process route refuses every call)
WHATSAPP_INTERNAL_TOKEN=
WHATSAPP_GRAPH_VERSION=
# Approved booking-received template name; leave empty until Meta approves it
WHATSAPP_BOOKING_TEMPLATE=
WHATSAPP_BOOKING_TEMPLATE_LANG=en
OPENAI_API_KEY=

# PASSPORT_ENCRYPTION_KEY does NOT go in .env files (they get bundled into the
# deployed worker). Local dev: put it in .dev.vars. Staging/prod: in
# .env.staging.secrets / .env.production.secrets (uploaded as Worker secrets).
# Make one with: openssl rand -base64 32. Changing it makes stored photos unreadable.

# KakaoTalk 알림톡 via Sendon (센드온 > 마이페이지 > API KEY). The server's IP
# must be on Sendon's IP whitelist.
SENDON_ID=
# SENDON_API_KEY is a secret: like PASSPORT_ENCRYPTION_KEY it goes in .dev.vars /
# .env.local locally and in .env.*.secrets for staging/prod, not in .env files.
# 카카오 채널 ID registered in Sendon (발신프로필)
SENDON_PROFILE_ID=
# Template IDs Sendon shows for each approved template
SENDON_TEMPLATE_BOOKING_RECEIVED=
SENDON_TEMPLATE_BOOKING_CONFIRMED=
SENDON_TEMPLATE_MONTHLY_RENT_DUE=
# "template" = send the template's SMS fallback text if KakaoTalk delivery fails
ALIMTALK_FALLBACK=
# Local dev / staging: every 알림톡 goes to this phone instead of the guest
ALIMTALK_DEV_PHONE_OVERRIDE=
