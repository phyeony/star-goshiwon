{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "goshiwon",
	"compatibility_date": "2026-04-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"routes": [
		{
			"pattern": "goshiwonseoul.com",
			"custom_domain": true
		},
		{
			"pattern": "www.goshiwonseoul.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "goshiwon"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"env": {
		"staging": {
			"name": "goshiwon-staging",
			"routes": [
				{
					"pattern": "staging.goshiwonseoul.com",
					"custom_domain": true
				}
			],
			"vars": {
				"STAGING": "true"
			},
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "goshiwon-staging"
				}
			],
			"images": {
				"binding": "IMAGES"
			}
		}
	}
}