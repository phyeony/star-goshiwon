{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "goshiwon",
	"compatibility_date": "2026-04-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"routes": [
		{
			"pattern": "goshiwonseoul.com",
			"custom_domain": true
		},
		{
			"pattern": "www.goshiwonseoul.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "goshiwon"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		"SUPABASE_URL": "https://sgymiebggwwwfjhwpezl.supabase.co",
		"ADMIN_EMAIL": "stargoshiwon.seoul@gmail.com",
		"SMTP_HOST": "smtp.gmail.com",
		"SMTP_PORT": "465",
		"SMTP_USER": "stargoshiwon.seoul@gmail.com",
		"FROM_EMAIL": "Seoul Goshiwon By Star Gositel <stargoshiwon.seoul@gmail.com>",
		"NEXT_PUBLIC_SITE_URL": "https://goshiwonseoul.com"
	},
	"observability": {
		"enabled": true
	},
	"env": {
		"staging": {
			"name": "goshiwon-staging",
			"routes": [
				{
					"pattern": "staging.goshiwonseoul.com",
					"custom_domain": true
				}
			],
			"vars": {
				"STAGING": "true",
				"SUPABASE_URL": "https://iolngphuzqbrupmemzxm.supabase.co",
				"SUPABASE_ANON_KEY": "sb_publishable_f48eyv7IksjjftqqaodmYQ_wROE1K9q",
				"ADMIN_EMAIL": "phyeony@gmail.com",
				"SMTP_HOST": "smtp.gmail.com",
				"SMTP_PORT": "465",
				"SMTP_USER": "phyeony@gmail.com",
				"DEV_EMAIL_OVERRIDE": "phyeony@gmail.com",
				"FROM_EMAIL": "Seoul Goshiwon By Star Gositel <stargoshiwon.seoul@gmail.com>",
				"NEXT_PUBLIC_SITE_URL": "https://staging.goshiwonseoul.com",
				"PAYPAL_ENV": "sandbox",
				"PAYPAL_CLIENT_ID": "AaPq05SkjzXXydR8aR5FOYd3qNHI3BONeXhBd9qsJcsCMwjB4AaQCJ5KBnUCGTBQqSsMof65M2MuQ_3p"
			},
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "goshiwon-staging"
				}
			],
			"images": {
				"binding": "IMAGES"
			}
		}
	}
}
