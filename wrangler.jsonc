{
	"$schema": "node_modules/wrangler/config-schema.json",
	// worker.ts wraps OpenNext's .open-next/worker.js and adds the WhatsApp
	// queue consumer and the daily cron (plan/whatsapp-agent.md §2.1).
	"main": "worker.ts",
	"name": "goshiwon",
	"compatibility_date": "2026-04-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"routes": [
		{
			"pattern": "goshiwonseoul.com",
			"custom_domain": true
		},
		{
			"pattern": "www.goshiwonseoul.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "goshiwon"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	// Website photos uploaded in admin → 사진 관리 (served at /media/…).
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "goshiwon-photos"
		}
	],
	"vars": {
		"SUPABASE_URL": "https://sgymiebggwwwfjhwpezl.supabase.co",
		"SUPABASE_ANON_KEY":"sb_publishable_hAaBw30Q0SOZh1TSSZ69Ig_FqA_qVDd",
		"ADMIN_EMAIL": "stargoshiwon.seoul@gmail.com",
		"SMTP_HOST": "smtp.gmail.com",
		"SMTP_PORT": "465",
		"SMTP_USER": "stargoshiwon.seoul@gmail.com",
		"FROM_EMAIL": "Seoul Goshiwon By Star Gositel <stargoshiwon.seoul@gmail.com>",
		"NEXT_PUBLIC_SITE_URL": "https://goshiwonseoul.com",
		"PHOTOS_PUBLIC_URL": "https://photos.goshiwonseoul.com",
		"PAYPAL_ENV": "live",
		"PAYPAL_CLIENT_ID": "AWDFTzwXMN1qkMVcygASeR-9NxdwOri0iydHsSmrmOiKFSN4p1eCxLBjTCLtI-Wgy_fORdE7rx7yx5-F",
		"PAYPAL_WEBHOOK_ID": "05753515EV4413204"
	},
	"observability": {
		"enabled": true
	},
	// WhatsApp agent jobs. Create once per account before the first deploy:
	//   pnpm wrangler queues create goshiwon-whatsapp
	"queues": {
		"producers": [{ "binding": "WHATSAPP_QUEUE", "queue": "goshiwon-whatsapp" }],
		"consumers": [{ "queue": "goshiwon-whatsapp", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 5 }]
	},
	// 03:00 Korea time: delete WhatsApp chats idle for 12 months.
	"triggers": { "crons": ["0 18 * * *"] },
	"env": {
		"staging": {
			"name": "goshiwon-staging",
			"routes": [
				{
					"pattern": "staging.goshiwonseoul.com",
					"custom_domain": true
				}
			],
			"vars": {
				"STAGING": "true",
				"SUPABASE_URL": "https://iolngphuzqbrupmemzxm.supabase.co",
				"SUPABASE_ANON_KEY": "sb_publishable_f48eyv7IksjjftqqaodmYQ_wROE1K9q",
				"ADMIN_EMAIL": "hyeonycanada@gmail.com, phyeony@gmail.com, stargoshiwon.seoul@gmail.com",
				"SMTP_HOST": "smtp.gmail.com",
				"SMTP_PORT": "465",
				"SMTP_USER": "hyeonycanada@gmail.com",
				"DEV_EMAIL_OVERRIDE": "hyeonycanada@gmail.com",
				"FROM_EMAIL": "Seoul Goshiwon By Star Gositel <stargoshiwon.seoul@gmail.com>",
				"NEXT_PUBLIC_SITE_URL": "https://staging.goshiwonseoul.com",
				"PHOTOS_PUBLIC_URL": "https://photos-staging.goshiwonseoul.com",
				"PAYPAL_ENV": "sandbox",
				"PAYPAL_CLIENT_ID": "AaPq05SkjzXXydR8aR5FOYd3qNHI3BONeXhBd9qsJcsCMwjB4AaQCJ5KBnUCGTBQqSsMof65M2MuQ_3p",
				"PAYPAL_WEBHOOK_ID": "3Y668234B0081663S"
			},
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "goshiwon-staging"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"r2_buckets": [
				{
					"binding": "PHOTOS",
					"bucket_name": "goshiwon-photos-staging"
				}
			],
			// pnpm wrangler queues create goshiwon-whatsapp-staging
			"queues": {
				"producers": [{ "binding": "WHATSAPP_QUEUE", "queue": "goshiwon-whatsapp-staging" }],
				"consumers": [{ "queue": "goshiwon-whatsapp-staging", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 5 }]
			},
			"triggers": { "crons": ["0 18 * * *"] }
		}
	}
}
